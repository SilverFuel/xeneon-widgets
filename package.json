{
  "name": "auxora-dashboard",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SilverFuel/xeneon-widgets.git"
  },
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File .\\start-xeneon.ps1",
    "check": "npm run check:js && npm run test:wow-forever && npm run test:tmog && npm run test:constellation-theme && npm run test:setup-secrets && npm run check:frontend-performance && npm run check:settings-handlers && npm run check:quick-controls && npm run check:album-carousel && npm run check:camera-detection && npm run test:frigate-standalone-refresh && npm run check:ui-remediation && npm run check:touch-root-press && npm run test:dashboard-navigation && npm run test:header-modes && npm run test:home-navigation && npm run test:ui-action-ownership && npm run check:adaptive-layouts && npm run test:visible-window-guard && npm run check:app && npm run test:app && npm run test:native-host-api && npm run test:bridge-api && npm run test:theme-rendered && npm run test:standalone-theme-rendered && npm run test:rendered-dashboard",
    "check:release": "npm run check && npm run check:standalone-theme && npm run check:setup-guide && npm run check:bridge-boundaries && npm run check:observability && npm run check:dependency-pins && npm run check:support-redaction && npm run check:display-recovery && npm run test:display-receipt && npm run test:frigate-receipt && npm run check:source-guards && npm run check:commercial-readiness && npm run test:release-version && npm run test:release-artifact && npm run test:json-lexical-types && npm run test:release-manifest && npm run test:release-environment && npm run check:release-gauntlet && npm run test:iexpress-packaging && npm run test:webview2-runtime && npm run check:installer-safety && npm run test:installer-host-stop && npm run test:installer-architecture && npm run check:audit-regressions",
    "check:js": "node scripts/check-js.mjs",
    "test:wow-forever": "node scripts/test-wow-forever.mjs && node scripts/test-wow-autolaunch.mjs",
    "test:tmog": "node scripts/test-tmog-companion.mjs",
    "check:standalone-theme": "node scripts/check-standalone-theme-contract.mjs",
    "check:setup-guide": "node scripts/check-setup-guide.mjs",
    "check:bridge-boundaries": "node scripts/check-bridge-boundaries.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "check:frontend-performance": "node scripts/check-frontend-performance.mjs",
    "check:settings-handlers": "node scripts/check-settings-handlers.mjs",
    "check:quick-controls": "node scripts/check-quick-controls.mjs",
    "check:album-carousel": "node scripts/check-album-carousel.mjs",
    "check:dependency-pins": "node scripts/check-dependency-pins.mjs",
    "check:support-redaction": "node scripts/check-support-redaction.mjs",
    "check:display-recovery": "node scripts/check-display-recovery.mjs",
    "test:display-receipt": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-display-qualification-receipt.ps1 && pwsh -NoProfile -File .\\scripts\\test-display-qualification-receipt.ps1",
    "check:camera-detection": "node scripts/check-camera-detection.mjs",
    "test:frigate-receipt": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-frigate-qualification-receipt.ps1 && pwsh -NoProfile -File .\\scripts\\test-frigate-qualification-receipt.ps1",
    "check:audit-regressions": "node scripts/check-audit-regressions.mjs",
    "check:source-guards": "node scripts/check-source-guards.mjs",
    "check:ui-remediation": "node scripts/check-ui-remediation.mjs",
    "check:touch-root-press": "node scripts/check-touch-root-press.mjs",
    "check:adaptive-layouts": "node scripts/check-adaptive-layout-matrix.mjs",
    "test:rendered-dashboard": "node scripts/test-rendered-dashboard.mjs",
    "test:theme-rendered": "node scripts/test-theme-rendered.mjs",
    "test:standalone-theme-rendered": "node scripts/test-standalone-theme-rendered.mjs",
    "check:commercial-readiness": "node scripts/check-commercial-readiness.mjs",
    "test:release-artifact": "powershell -ExecutionPolicy Bypass -NoProfile -File .\\scripts\\test-release-artifact-verifier.ps1",
    "test:release-manifest": "powershell -ExecutionPolicy Bypass -NoProfile -File .\\scripts\\test-release-manifest.ps1 && pwsh -NoProfile -File .\\scripts\\test-release-manifest.ps1",
    "test:release-environment": "powershell -ExecutionPolicy Bypass -NoProfile -File .\\scripts\\test-github-release-environment.ps1 && pwsh -NoProfile -File .\\scripts\\test-github-release-environment.ps1",
    "test:release-version": "powershell -ExecutionPolicy Bypass -NoProfile -File .\\scripts\\Test-ReleaseVersion.ps1 && powershell -ExecutionPolicy Bypass -NoProfile -File .\\scripts\\test-release-version-mode.ps1",
    "check:release-gauntlet": "node scripts/check-release-gauntlet.mjs",
    "check:installer-safety": "node scripts/check-installer-safety.mjs",
    "test:installer-host-stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer-host-stop.ps1 && pwsh -NoProfile -File scripts/test-installer-host-stop.ps1",
    "test:iexpress-packaging": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-iexpress-packaging.ps1",
    "test:webview2-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-webview2-runtime-probe.ps1 && pwsh -NoProfile -File .\\scripts\\test-webview2-runtime-probe.ps1",
    "check:app": "dotnet build app\\XenonEdgeHost.sln --configuration Release -m:1 -p:UseSharedCompilation=false",
    "test:native-host-api": "node scripts/test-native-host-api.mjs",
    "test:bridge-api": "node scripts/test-bridge-api.mjs",
    "test:app": "dotnet test app\\XenonEdgeHost.sln --configuration Release --no-restore",
    "audit:deps": "npm audit --audit-level=moderate && npm --prefix desktop/electron audit --audit-level=moderate && dotnet restore app\\XenonEdgeHost.sln --force-evaluate && dotnet list app\\XenonEdgeHost.sln package --vulnerable --include-transitive",
    "clean": "powershell -ExecutionPolicy Bypass -File .\\scripts\\clean-workspace.ps1",
    "installer": "powershell -ExecutionPolicy Bypass -File .\\app\\build-installer.ps1",
    "release:gauntlet": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-release-gauntlet.ps1 -AllowGitHubSupportPath -AllowUnsignedBeta",
    "release:free-beta": "powershell -ExecutionPolicy Bypass -File .\\scripts\\prepare-free-beta-release.ps1",
    "release:ready": "powershell -ExecutionPolicy Bypass -File .\\scripts\\assert-release-ready.ps1 -AllowGitHubSupportPath",
    "release:ready-beta": "powershell -ExecutionPolicy Bypass -File .\\scripts\\assert-release-ready.ps1 -AllowGitHubSupportPath -AllowBetaVersion -RequireUnsignedInstaller",
    "release:commercial": "npm run test:release-artifact && powershell -ExecutionPolicy Bypass -NoProfile -File .\\scripts\\run-release-gauntlet.ps1 -RequireSignedInstaller -CommercialEvidencePath .\\commercial-launch-evidence.json",
    "release:windows-beta": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-release.ps1 -AllowUnsignedBeta",
    "mac:install": "npm --prefix desktop/electron install",
    "mac:start": "npm --prefix desktop/electron start",
    "mac:dist": "npm --prefix desktop/electron run dist:mac",
    "bridge": "node bridge/server.mjs",
    "bridge:install": "powershell -ExecutionPolicy Bypass -File .\\bridge\\install-bridge.ps1",
    "bridge:uninstall": "powershell -ExecutionPolicy Bypass -File .\\bridge\\uninstall-bridge.ps1",
    "test:visible-window-guard": "node scripts/test-visible-window-guard.mjs",
    "test:setup-secrets": "node scripts/test-setup-secrets.mjs",
    "test:frigate-standalone-refresh": "node scripts/test-frigate-standalone-refresh.mjs",
    "test:json-lexical-types": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-json-lexical-types.ps1 && pwsh -NoProfile -File scripts/test-json-lexical-types.ps1",
    "test:installer-architecture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer-architecture.ps1 && pwsh -NoProfile -File scripts/test-installer-architecture.ps1",
    "test:constellation-theme": "node scripts/test-constellation-theme.mjs",
    "test:dashboard-navigation": "node scripts/test-dashboard-navigation.mjs",
    "test:header-modes": "node scripts/test-header-modes.mjs",
    "test:home-navigation": "node scripts/test-home-navigation.mjs",
    "test:ui-action-ownership": "node scripts/test-ui-action-ownership.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
