<Window
    x:Class="XenonEdgeHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Auxora">
    <Grid Background="#F4F5F7" RequestedTheme="Light">
        <controls:WebView2
            x:Name="DashboardView"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Border
            x:Name="OverlayPanel"
            Margin="24"
            Padding="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            MaxWidth="640"
            Background="#FFF4F5F7"
            BorderBrush="#FFD4AC63"
            BorderThickness="1"
            CornerRadius="18">
            <StackPanel Spacing="10">
                <TextBlock
                    Text="Auxora"
                    Foreground="#FF2B4D7D"
                    FontSize="28"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="StatusText"
                    AutomationProperties.LiveSetting="Polite"
                    Text="Starting bridge..."
                    Foreground="#FF2B4D7D"
                    FontSize="16"
                    Opacity="0.9"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid
            x:Name="DisplayPickerPanel"
            Background="#FFF4F5F7"
            Visibility="Collapsed">
            <Border
                Margin="32"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                MaxWidth="980"
                Background="#FFFFFFFF"
                BorderBrush="#FFD4AC63"
                BorderThickness="1"
                CornerRadius="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock
                            Text="Choose an Auxora companion display"
                            Foreground="#FF2B4D7D"
                            FontSize="30"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Text="Auxora never uses your Windows primary display. Choose an available companion display and Auxora will remember it."
                            Foreground="#FF2B4D7D"
                            FontSize="16"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,24,0,0"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DisplayPickerList" Spacing="12" />
                    </ScrollViewer>

                    <TextBlock
                        x:Name="DisplayPickerStatus"
                        AutomationProperties.LiveSetting="Polite"
                        Grid.Row="2"
                        Margin="0,18,0,0"
                        Text="You can change this later in Settings → Diagnostics."
                        Foreground="#FF2B4D7D"
                        FontSize="14"
                        TextWrapping="WrapWholeWords" />

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,20,0,0"
                        Spacing="12">
                        <Button
                            Padding="18,10"
                            Click="HandleRefreshDisplays"
                            Foreground="#FF2B4D7D"
                            Background="#FFF4F5F7"
                            BorderBrush="#FF2B4D7D"
                            BorderThickness="1"
                            CornerRadius="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                            <TextBlock Text="Refresh displays" TextWrapping="WrapWholeWords" />
                        </Button>
                        <Button
                            Padding="18,10"
                            Click="HandleOpenWindowsDisplaySettings"
                            Foreground="#FF2B4D7D"
                            Background="#FFF4F5F7"
                            BorderBrush="#FF2B4D7D"
                            BorderThickness="1"
                            CornerRadius="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                            <TextBlock Text="Open Windows display settings" TextWrapping="WrapWholeWords" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
